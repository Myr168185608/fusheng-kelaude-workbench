{
  "id": "claude-tan",
  "type": "plugin",
  "name": "Claude 娘",
  "version": "2.0.0",
  "description": "橙发呆毛、星芒发饰的 Claude 娘立绘桌宠：会眨眼说话，跟着任务思考、敲代码、举手提问、欢呼庆祝，额度紧张时劝你歇一歇。摸摸头，好感会越来越高。",
  "author": "浮生氪劳德工作台",
  "license": "MIT",
  "engines": {
    "workbench": ">=1.1.0"
  },
  "icon": "✻",
  "accent": "#d97757",
  "tags": [
    "宠物",
    "陪伴",
    "趣味"
  ],
  "permissions": [
    "activity",
    "usage.read",
    "storage"
  ],
  "main": "pet.js",
  "style": "pet.css",
  "contributes": {
    "overlay": {
      "title": "Claude 娘",
      "width": 160,
      "height": 240,
      "anchor": "bottom-right"
    },
    "commands": [
      {
        "id": "pet",
        "title": "摸摸 Claude 娘的头",
        "subtitle": "她会很开心",
        "icon": "sparkles"
      },
      {
        "id": "cheer",
        "title": "让 Claude 娘打打气",
        "subtitle": "累了的时候点一下",
        "icon": "sparkles"
      }
    ]
  }
}
