{
  "id": "focus-timer",
  "type": "plugin",
  "name": "番茄专注",
  "version": "1.0.0",
  "description": "番茄工作法计时器：专注 25 分钟、休息 5 分钟，状态栏实时倒计时，到点提醒；面板里记录每天完成的番茄数。",
  "author": "浮生氪劳德工作台",
  "license": "MIT",
  "engines": { "workbench": ">=1.1.0" },
  "icon": "🍅",
  "accent": "#d1493f",
  "tags": ["效率", "专注", "番茄钟"],
  "permissions": ["storage", "ui.toast", "ui.statusbar"],
  "main": "timer.js",
  "style": "timer.css",
  "contributes": {
    "panel": { "title": "番茄专注" },
    "background": true,
    "commands": [
      { "id": "toggle", "title": "开始 / 暂停番茄钟", "subtitle": "在状态栏倒计时", "icon": "clock" },
      { "id": "open", "title": "打开番茄专注", "subtitle": "计时器与专注记录", "icon": "clock", "action": "open-panel" }
    ]
  }
}
