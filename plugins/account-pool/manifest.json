{
  "id": "account-pool",
  "type": "plugin",
  "name": "多账号轮询",
  "version": "1.0.1",
  "description": "可选的官方账号配置管理：独立登录、会话绑定、逐轮轮询与按额度选择。停用后停止新路由，凭据始终由官方 CLI 管理。",
  "author": "浮生氪劳德工作台",
  "license": "MIT",
  "engines": { "workbench": ">=1.3.0" },
  "icon": "🔁",
  "accent": "#2f6a52",
  "tags": ["账号", "轮询", "可选"],
  "permissions": ["backend", "sessions.read"],
  "main": "main.js",
  "style": "style.css",
  "backend": "backend.mjs",
  "contributes": {
    "panel": { "title": "多账号轮询" },
    "commands": [
      { "id": "open", "title": "打开多账号轮询", "subtitle": "登录状态、独立配置和会话绑定", "icon": "users", "action": "open-panel" }
    ]
  }
}
