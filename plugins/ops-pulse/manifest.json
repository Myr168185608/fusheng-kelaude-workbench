  "license": "MIT",
  "engines": { "workbench": ">=1.1.0" },
  "icon": "💓",
  "accent": "#d9822b",
  "tags": ["运维", "监控", "效率"],
  "permissions": ["system.read", "composer.insert", "storage"],
  "main": "pulse.js",
  "style": "pulse.css",
  "contributes": {
    "widget": { "title": "运维脉搏", "size": "wide", "height": 250 }
  }
